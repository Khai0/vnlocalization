<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Vietnamese Localization &amp; Language Services | VNlocalization</title>
    <meta
      name="description"
      content="Vietnamese translation, LQA, subtitling, dubbing and voice-over. Native language support for global content teams."
    />
    <meta name="theme-color" content="#172b2a" />
    <meta
      property="og:title"
      content="Vietnamese Localization &amp; Language Services | VNlocalization"
    />
    <meta
      property="og:description"
      content="Vietnamese translation, LQA, subtitling, dubbing and voice-over. Native language support for global content teams."
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="vnlocalization.com" />
    <link rel="icon" href="/assets/crane-emblem.png" type="image/png" />
    <link
      rel="preload"
      href="/assets/fonts/be-vietnam-pro-latin-600-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="stylesheet" href="/assets/fonts.css" />
    <link rel="stylesheet" href="/assets/style.css" />
    <link rel="stylesheet" href="/assets/theme.css" />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "VNlocalization",
        "description": "Vietnamese translation, localization, linguistic quality assurance, subtitling, and dubbing.",
        "url": "https://vnlocalization.com",
        "email": "info@penguinsgroup.com.vn",
        "telephone": "+84961003512",
        "address": { "@type": "PostalAddress", "addressLocality": "Hue", "addressCountry": "VN" }
      }
    </script>
    <script id="locale-data" type="application/json">
      {
        "locale": "en",
        "strings": {
          "Open navigation": "Open navigation",
          "Close navigation": "Close navigation",
          "NATURAL • CONTEXT-AWARE": "NATURAL • CONTEXT-AWARE",
          "LITERAL • NEEDS CONTEXT": "LITERAL • NEEDS CONTEXT",
          "An energetic, natural invitation for an action game.": "An energetic, natural invitation for an action game.",
          "Word-for-word phrasing loses the intended invitation and tone.": "Word-for-word phrasing loses the intended invitation and tone.",
          "✓ Reviewed": "✓ Reviewed",
          "△ Needs review": "△ Needs review",
          "Your project brief has been downloaded. No inquiry has been sent.": "Your project brief has been downloaded. No inquiry has been sent.",
          "Please review and send the draft in your email app to info@penguinsgroup.com.vn. If no app opens, email your project details directly to this address.": "Please review and send the draft in your email app to info@penguinsgroup.com.vn. If no app opens, email your project details directly to this address.",
          "Project inquiry": "Project inquiry",
          "Name": "Name",
          "Email": "Email",
          "Company": "Company",
          "Service": "Service",
          "Languages": "Languages",
          "Deadline": "Deadline",
          "Details": "Details"
        }
      }
    </script>
    <script src="/assets/main.js" defer></script>
    <link rel="canonical" href="https://vnlocalization.com/en/" />
    <link rel="alternate" hreflang="en" href="https://vnlocalization.com/en/" />
    <link rel="alternate" hreflang="vi" href="https://vnlocalization.com/vi/" />
    <link rel="alternate" hreflang="zh-Hans" href="https://vnlocalization.com/zh/" />
    <link rel="alternate" hreflang="ja" href="https://vnlocalization.com/ja/" />
    <link rel="alternate" hreflang="ko" href="https://vnlocalization.com/ko/" />
    <link rel="alternate" hreflang="x-default" href="https://vnlocalization.com/en/" />
  </head>
