                  <i></i><i></i><i></i>
                  <div>
                    <span>ENGLISH → VIETNAMESE</span><b lang="vi">Khám phá<br />điều mới.</b
                    ><em>EN → VI ↗</em>
                  </div>
                </div>
                <span class="art-glyph">ă</span>
              </div>
              <div class="icon">A↔ă <span class="num">01</span></div>
